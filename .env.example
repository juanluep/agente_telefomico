# ── Base de datos ───────────────────────────────────────────────
# Estas tres las consume docker-compose para inicializar el motor.
POSTGRES_USER=voiceops
POSTGRES_PASSWORD=
POSTGRES_DB=voiceops

# lib/env.ts compone las URLs de conexión a partir de las piezas de arriba
# más DB_HOST, para no repetir la contraseña en tres sitios y que se
# desincronicen. En desarrollo DB_HOST=localhost; en Dokploy, DB_HOST=db.
DB_HOST=localhost
DB_PORT=5432
APP_DB_USER=app_user
APP_DB_PASSWORD=

# ── Aplicación ──────────────────────────────────────────────────
# En desarrollo: la URL del Funnel de Tailscale (§15), porque de ella se
# compone el server.url que se envía a VAPI. En producción: https://<tu-dominio>
APP_URL=https://<equipo>.<tailnet>.ts.net
# Solo producción: dominio sin protocolo, para Traefik (§16). Debe coincidir
# con el host de APP_URL.
APP_DOMAIN=

# ── VAPI ────────────────────────────────────────────────────────
VAPI_API_KEY=
VAPI_SERVER_CREDENTIAL_ID=
VAPI_WEBHOOK_TOKEN=

# ── Localización ────────────────────────────────────────────────
DEFAULT_TIMEZONE=Europe/Madrid
DEFAULT_COUNTRY_CODE=ES